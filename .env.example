# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every variable here is validated at startup by src/server/config/env.ts.
# A missing or malformed value fails fast with a readable message rather than
# surfacing later as a confusing runtime error.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Port 55432 is intentional (see that file).
DATABASE_URL="postgresql://anvaya:anvaya_dev_password@localhost:55432/anvaya?schema=public"

# Managed-Postgres alternative, if you would rather not run Docker. Neon and
# Supabase both work; append ?sslmode=require.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Application ------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:8080"

# --- Auth (used from Phase 3) -----------------------------------------------
# Generate a fresh one — never reuse this placeholder outside local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"

# How long a session stays valid without activity.
SESSION_MAX_AGE_SECONDS="28800"
# Absolute cap: a session ends this long after sign-in however active it is.
SESSION_ABSOLUTE_MAX_SECONDS="86400"

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL="debug"
# Pretty-print logs in the terminal. Turn off in production for JSON output.
LOG_PRETTY="true"

# --- Seeding ----------------------------------------------------------------
# Password given to every seeded demo user. Local demo data only.
SEED_USER_PASSWORD="Anvaya!Demo2026"
