// Anvaya — database schema.
//
// Phase 1 establishes the datasource, generator and migration workflow with
// the root of the organisation tree. Phase 2 adds the remaining tables
// (materials, BOMs, inventory, demand, supply, planning), all of which hang
// off Company.
//
// Conventions used throughout:
//   - `id`           cuid primary key
//   - business keys  carry an explicit @unique, scoped to the company
//   - every FK       is indexed (Postgres does not do this automatically)
//   - timestamps     createdAt / updatedAt on every table
//   - money          Decimal(18, 4); quantities Decimal(18, 6)
//                    never Float — binary floating point cannot represent
//                    decimal quantities exactly, and MRP arithmetic compounds
//                    the error across BOM levels.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes a connection URL here. The CLI reads it from
// prisma.config.ts; the runtime gets it through the pg driver adapter in
// src/server/db/client.ts.
datasource db {
  provider = "postgresql"
}

/// The tenant root. Every business record belongs to exactly one company,
/// which is what makes the app multi-tenant-ready without retrofitting later.
model Company {
  id       String  @id @default(cuid())
  /// Short stable identifier used in URLs and exports.
  code     String  @unique
  name     String
  legalName String?

  /// ISO 4217, e.g. "INR". Drives money formatting across the app.
  currencyCode String @default("INR")
  /// IANA zone, e.g. "Asia/Kolkata". MRP buckets are computed in this zone,
  /// so it must be explicit rather than inherited from the server.
  timezone     String @default("Asia/Kolkata")

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("IN")

  taxId String?

  isActive Boolean @default(true)

  settings CompanySetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("companies")
}

/// Namespaced key/value configuration, one row per setting per company.
///
/// A table rather than a JSON blob on Company so individual settings can be
/// audited, permissioned and changed concurrently without lost updates.
model CompanySetting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Grouping, e.g. "mrp", "inventory", "notifications".
  namespace String
  key       String
  /// JSON-encoded, so a setting can hold a scalar, list or object.
  value     Json
  /// Human-readable note shown next to the control in Settings.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, namespace, key])
  @@index([companyId])
  @@map("company_settings")
}
