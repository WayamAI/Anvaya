// Anvaya — database schema.
//
// Conventions used throughout:
//   - `id`              cuid primary key
//   - business keys     @unique, scoped to the company (multi-tenant safe)
//   - every FK          indexed; Postgres does not index them automatically
//   - timestamps        createdAt / updatedAt on every table
//   - quantities        Decimal(18, 6)
//   - money             Decimal(18, 4)
//                       never Float — binary floating point cannot represent
//                       decimal quantities exactly, and MRP arithmetic
//                       compounds the error across BOM levels.
//
// Deletes are restricted by default. Master data that planning results point
// at must not vanish underneath them; only rows that are meaningless without
// their parent (order lines, BOM components, run results) cascade.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes a connection URL here. The CLI reads it from
// prisma.config.ts; the runtime gets it through the pg driver adapter in
// src/server/db/client.ts.
datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

/// Presentational grouping only. MRP decides how to supply a material from
/// its procurementType policy, never from this field.
enum MaterialKind {
  RAW
  PACKAGING
  SEMI_FINISHED
  FINISHED
  CONSUMABLE
}

/// How MRP supplies a material at a location. This is what makes a planned
/// order a purchase or a production order, so it is explicit rather than
/// inferred from whether a BOM happens to exist.
enum ProcurementType {
  BUY
  MAKE
}

enum LotSizingRule {
  /// Order exactly the net requirement.
  LOT_FOR_LOT
  /// Always order a fixed quantity.
  FIXED_ORDER_QTY
  /// Order the net requirement, raised to the minimum and rounded up to the
  /// order multiple.
  MIN_ORDER_QTY
  /// Combine the net requirements of N days into one order.
  PERIOD_ORDER_QTY
}

enum LocationType {
  PLANT
  WAREHOUSE
  DEPOT
  HUB
}

enum QcStatus {
  PENDING
  APPROVED
  QUARANTINE
  REJECTED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_RECEIPT
  PRODUCTION_ISSUE
  SCRAP
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
}

enum CustomerType {
  DISTRIBUTOR
  MODERN_TRADE
  ECOMMERCE
  INSTITUTIONAL
}

enum WorkOrderStatus {
  PLANNED
  FIRMED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ConstraintType {
  CAPACITY
  LABOUR
  EQUIPMENT
  MATERIAL
  REGULATORY
}

enum MrpRunStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlannedOrderType {
  PURCHASE
  PRODUCTION
}

enum PlannedOrderStatus {
  PLANNED
  FIRMED
  CONVERTED
  CANCELLED
}

/// Where a requirement came from. Independent demand originates outside the
/// plan; DEPENDENT is generated by exploding a parent's planned order.
enum DemandSourceType {
  SALES_ORDER
  FORECAST
  DEPENDENT
  SAFETY_STOCK
  WORK_ORDER
}

enum MrpExceptionType {
  MATERIAL_SHORTAGE
  LATE_SUPPLY
  PAST_DUE_RELEASE
  MISSING_BOM
  MISSING_VENDOR
  MISSING_LEAD_TIME
  EXCESS_STOCK
  BOM_CYCLE
  /// Policy rules that cannot all be honoured, e.g. a maximum order quantity
  /// below the order multiple.
  POLICY_CONFLICT
  /// An open receipt due shortly after the need, used to cover it instead of
  /// planning duplicate supply: it must be expedited.
  RESCHEDULE_IN
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ForecastMethod {
  MANUAL
  MOVING_AVERAGE
  EXPONENTIAL_SMOOTHING
  SEASONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  APPROVE
  RECEIVE
  ADJUST
  MRP_RUN
  CANCEL
  RELEASE
  DISPATCH
  ISSUE
  COMPLETE
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

// ===========================================================================
// Organisation
// ===========================================================================

/// The tenant root. Every business record belongs to exactly one company,
/// which is what makes the app multi-tenant-ready without retrofitting later.
model Company {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  legalName String?

  /// ISO 4217, e.g. "INR". Drives money formatting across the app.
  currencyCode String @default("INR")
  /// IANA zone. MRP buckets are computed in this zone, so it must be explicit
  /// rather than inherited from whatever the server happens to be set to.
  timezone     String @default("Asia/Kolkata")

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("IN")
  taxId        String?

  isActive Boolean @default(true)

  settings           CompanySetting[]
  locations          Location[]
  users              User[]
  roles              Role[]
  materialCategories MaterialCategory[]
  unitsOfMeasure     UnitOfMeasure[]
  materials          Material[]
  vendors            Vendor[]
  customers          Customer[]
  boms               Bom[]
  salesOrders        SalesOrder[]
  forecasts          DemandForecast[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  workOrders         WorkOrder[]
  constraints        ProductionConstraint[]
  mrpRuns            MrpRun[]
  auditLogs          AuditLog[]
  integrations       Integration[]
  documentSequences  DocumentSequence[]
  idempotencyKeys    IdempotencyKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("companies")
}

/// Namespaced key/value configuration, one row per setting.
///
/// A table rather than a JSON blob on Company so individual settings can be
/// audited, permissioned and changed concurrently without lost updates.
model CompanySetting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Grouping, e.g. "mrp", "inventory", "notifications".
  namespace   String
  key         String
  /// JSON-encoded, so a setting can hold a scalar, list or object.
  value       Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, namespace, key])
  @@index([companyId])
  @@map("company_settings")
}

/// A plant, warehouse, depot or hub. Inventory and planning policy are both
/// per-location, because the same material is planned differently in Pune
/// than in a Chennai depot.
model Location {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String
  type LocationType @default(WAREHOUSE)

  city    String?
  state   String?
  country String? @default("IN")

  /// Whether production can be scheduled here.
  isManufacturing Boolean @default(false)
  isActive        Boolean @default(true)

  policies        MaterialLocationPolicy[]
  balances        InventoryBalance[]
  lots            InventoryLot[]
  movements       StockMovement[]
  adjustments     InventoryAdjustment[]
  salesOrderLines SalesOrderLine[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  workOrders      WorkOrder[]
  constraints     ProductionConstraint[]
  forecasts       DemandForecast[]
  mrpRequirements MrpRequirement[]
  plannedOrders   PlannedOrder[]
  mrpExceptions   MrpException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("locations")
}

// ===========================================================================
// Identity, roles and permissions
// ===========================================================================

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String
  name         String
  /// argon2id hash. Never a plaintext or reversible value.
  passwordHash String

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Set when an administrator issues a password. Until the user sets their
  /// own, the API allows nothing but changing it, reading /auth/me and
  /// signing out.
  mustChangePassword Boolean @default(false)

  /// Consecutive failed logins, used to throttle credential stuffing.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  mrpRunsTriggered   MrpRun[]              @relation("MrpRunTriggeredBy")
  adjustmentsMade    InventoryAdjustment[] @relation("AdjustmentCreatedBy")
  purchaseOrdersMade PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  purchaseOrdersOkd  PurchaseOrder[]       @relation("PurchaseOrderApprovedBy")
  movementsPosted    StockMovement[]       @relation("StockMovementPostedBy")
  receiptsMade       GoodsReceipt[]        @relation("GoodsReceiptReceivedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped to the company so the same address can exist in two tenants.
  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("users")
}

/// A named bag of permissions. Roles are data, not hard-coded strings, so the
/// Users & Roles screen can eventually edit them without a code change.
model Role {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  /// System roles cannot be deleted or renamed through the API.
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("roles")
}

/// A single capability, e.g. `material:create`, `mrp:run`, `po:approve`.
/// Global rather than per-company: the catalogue of what the software can do
/// is the same for everyone; which roles hold them is per-company.
model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  /// Resource half of the code, e.g. "material". Handy for grouping in the UI.
  resource    String
  /// Action half, e.g. "create".
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Server-side session record, so a session can be revoked and audited rather
/// than only expiring inside a cookie.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the session token. The raw token only ever exists in the
  /// cookie, so a database leak does not hand over live sessions.
  tokenHash String   @unique
  expiresAt DateTime

  ipAddress String?
  userAgent String?

  revokedAt DateTime?

  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ===========================================================================
// Master data
// ===========================================================================

model MaterialCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Optional one-level-up grouping, e.g. "Chemical" under "Raw material".
  parentId String?
  parent   MaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MaterialCategory[] @relation("CategoryTree")

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@map("material_categories")
}

model UnitOfMeasure {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// "KG", "L", "PCS", "UNIT".
  code      String
  name      String
  /// MASS, VOLUME, COUNT — conversions are only legal within a dimension.
  dimension String

  materials     Material[]
  bomComponents BomComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units_of_measure")
}

/// The item master. Raw materials, packaging, semi-finished and finished
/// goods all live here — a material is only "a component" or "a product"
/// relative to a particular BOM, never intrinsically.
model Material {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "RM-4023", "PM-1001", "SA-101", "FG-001".
  code        String
  name        String
  description String?

  kind MaterialKind

  categoryId String?
  category   MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Stocking unit. BOM lines may quote another unit in the same dimension.
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  /// Moving average cost in company currency, per stocking unit.
  standardCost Decimal? @db.Decimal(18, 4)

  /// Shelf life, where the material has one. Drives lot expiry at receipt.
  shelfLifeDays Int?

  isBatchTracked Boolean @default(false)
  isActive       Boolean @default(true)

  policies        MaterialLocationPolicy[]
  boms            Bom[]
  bomComponents   BomComponent[]
  vendorMaterials VendorMaterial[]
  balances        InventoryBalance[]
  lots            InventoryLot[]
  movements       StockMovement[]
  adjustments     InventoryAdjustment[]
  salesOrderLines SalesOrderLine[]
  forecasts       DemandForecast[]
  poLines         PurchaseOrderLine[]
  grnLines        GoodsReceiptLine[]
  workOrders      WorkOrder[]
  workOrderComps  WorkOrderComponent[]
  mrpRequirements MrpRequirement[]
  plannedOrders   PlannedOrder[]
  mrpExceptions   MrpException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, kind])
  @@index([companyId, isActive])
  @@index([categoryId])
  @@index([unitOfMeasureId])
  @@map("materials")
}

/// Planning policy for one material at one location.
///
/// Deliberately not on Material: safety stock, reorder point, lead time and
/// lot sizing legitimately differ between a plant and a depot, and MRP reads
/// them per location.
model MaterialLocationPolicy {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  procurementType ProcurementType @default(BUY)

  /// Quantity held to absorb demand and supply variability.
  safetyStock  Decimal @default(0) @db.Decimal(18, 6)
  /// Stock level at which replenishment should already be under way.
  reorderPoint Decimal @default(0) @db.Decimal(18, 6)

  lotSizingRule LotSizingRule @default(LOT_FOR_LOT)
  minOrderQty   Decimal       @default(0) @db.Decimal(18, 6)
  maxOrderQty   Decimal?      @db.Decimal(18, 6)
  /// Orders are rounded up to a whole multiple of this, when non-zero.
  orderMultiple Decimal       @default(0) @db.Decimal(18, 6)
  /// Days combined into a single order under PERIOD_ORDER_QTY.
  periodDays    Int?

  /// Used when procurementType is MAKE. Purchase lead time comes from the
  /// vendor record instead, so the two can never be confused.
  productionLeadTimeDays Int @default(0)
  /// Extra days added to any lead time as a buffer.
  safetyLeadTimeDays     Int @default(0)

  /// Inputs to the statistical safety-stock recommendation shown on the
  /// Safety Stock screen: SS = Z x stdDev x sqrt(leadTime).
  averageDailyDemand Decimal? @db.Decimal(18, 6)
  demandStdDev       Decimal? @db.Decimal(18, 6)
  /// Target cycle service level, e.g. 0.95.
  serviceLevel       Decimal? @db.Decimal(5, 4)

  /// A/B/C by consumption value.
  abcClass String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, locationId])
  @@index([materialId])
  @@index([locationId])
  @@map("material_location_policies")
}

// ===========================================================================
// Trading partners
// ===========================================================================

model Vendor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "SUP-001".
  code       String
  /// Secondary code carried from the vendor master: "VEN-GS-001".
  vendorCode String?
  name       String

  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  addressLine1  String?
  city          String?
  state         String?
  country       String? @default("IN")

  /// Free text as negotiated, e.g. "Net 30".
  paymentTerms String?
  /// On the Approved Supplier List.
  isApproved   Boolean @default(false)
  isActive     Boolean @default(true)

  materials      VendorMaterial[]
  scorecards     VendorScorecard[]
  purchaseOrders PurchaseOrder[]
  lots           InventoryLot[]
  goodsReceipts  GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("vendors")
}

/// What a vendor can supply, at what price and how fast.
///
/// This is where purchase lead time lives, because it is a property of the
/// vendor-material pair rather than of the material alone.
model VendorMaterial {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  leadTimeDays Int
  unitPrice    Decimal? @db.Decimal(18, 4)
  currencyCode String   @default("INR")

  minOrderQty   Decimal @default(0) @db.Decimal(18, 6)
  orderMultiple Decimal @default(0) @db.Decimal(18, 6)

  /// The vendor MRP picks when several can supply the same material.
  isPreferred Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, materialId])
  @@index([vendorId])
  @@index([materialId])
  @@index([materialId, isPreferred])
  @@map("vendor_materials")
}

/// Periodic quality and delivery performance, kept as history rather than
/// overwritten, so a trend is visible.
model VendorScorecard {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  defectRatePercent     Decimal? @db.Decimal(9, 4)
  onTimeDeliveryPercent Decimal? @db.Decimal(9, 4)
  /// Cost of poor quality, in company currency.
  copqAmount            Decimal? @db.Decimal(18, 4)

  lastAuditDate DateTime? @db.Date
  /// PASS / CONDITIONAL / FAIL.
  auditResult   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, periodStart, periodEnd])
  @@index([vendorId])
  @@map("vendor_scorecards")
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "CUST-001".
  code String
  name String
  type CustomerType @default(DISTRIBUTOR)

  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  city          String?
  state         String?
  country       String? @default("IN")

  paymentTerms String?
  isActive     Boolean @default(true)

  salesOrders SalesOrder[]
  forecasts   DemandForecast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("customers")
}

// ===========================================================================
// Engineering — bills of material
// ===========================================================================

/// The BOM header for one produced material. Versions hold the actual
/// structure, so a change is a new version rather than an edit in place —
/// a work order built last month must still explain what it consumed.
model Bom {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The material this BOM produces.
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  code        String
  name        String
  description String?

  versions BomVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([materialId])
  @@map("boms")
}

model BomVersion {
  id    String @id @default(cuid())
  bomId String
  bom   Bom    @relation(fields: [bomId], references: [id], onDelete: Cascade)

  /// "A", "B", "Rev 3" — as engineering labels it.
  version String

  /// The component quantities below produce this much output. Quantities per
  /// unit are derived by dividing, which keeps fractional recipes exact.
  baseQuantity Decimal @default(1) @db.Decimal(18, 6)

  /// Exactly one version per BOM may be active; enforced in the service layer
  /// and asserted by tests, since Postgres cannot express it as a plain
  /// unique constraint.
  isActive Boolean @default(false)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  components BomComponent[]
  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bomId, version])
  @@index([bomId])
  @@index([bomId, isActive])
  @@map("bom_versions")
}

model BomComponent {
  id           String     @id @default(cuid())
  bomVersionId String
  bomVersion   BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  /// Display order within the version.
  position Int @default(0)

  /// Quantity consumed per `baseQuantity` of the parent.
  quantity        Decimal       @db.Decimal(18, 6)
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  /// Expected loss, as a fraction (0.02 = 2%). Gross requirements are
  /// inflated by this during explosion.
  scrapFactor Decimal @default(0) @db.Decimal(9, 6)

  /// Days this component is needed before the parent completes. Lets a long
  /// component be pulled in earlier than the parent's own release.
  leadTimeOffsetDays Int @default(0)

  isOptional Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bomVersionId, materialId, position])
  @@index([bomVersionId])
  @@index([materialId])
  @@map("bom_components")
}

// ===========================================================================
// Inventory
// ===========================================================================

/// Derived cache of the stock ledger, one row per material per location.
///
/// StockMovement is the source of truth; this is recomputed in the same
/// transaction as every movement so reads stay cheap. Never written directly.
model InventoryBalance {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Physically present, whatever its commitment.
  onHandQty     Decimal @default(0) @db.Decimal(18, 6)
  /// Committed to sales orders or work orders but not yet issued.
  reservedQty   Decimal @default(0) @db.Decimal(18, 6)
  /// Held by quality and not usable for planning.
  quarantineQty Decimal @default(0) @db.Decimal(18, 6)

  /// Value of on-hand stock, in company currency.
  valuation Decimal @default(0) @db.Decimal(18, 4)

  lastMovementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, locationId])
  @@index([materialId])
  @@index([locationId])
  @@map("inventory_balances")
}

/// A received or produced batch. Carries the supplier lot and CoA so the
/// Batch Tracking and Traceability screens can walk backwards from finished
/// goods to the vendor lot that went into them.
model InventoryLot {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// Internal batch number assigned at receipt or production.
  lotNumber String

  /// Vendor's own lot reference, when purchased.
  supplierLotNumber String?
  vendorId          String?
  vendor            Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  receivedQty  Decimal @db.Decimal(18, 6)
  consumedQty  Decimal @default(0) @db.Decimal(18, 6)
  remainingQty Decimal @db.Decimal(18, 6)

  receiptDate DateTime  @db.Date
  expiryDate  DateTime? @db.Date

  qcStatus     QcStatus  @default(PENDING)
  coaReference String?
  releaseDate  DateTime? @db.Date
  releasedBy   String?

  storageLocation String?
  bin             String?

  movements  StockMovement[]
  grnLines   GoodsReceiptLine[]
  consumedBy WorkOrderComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, lotNumber])
  @@index([materialId])
  @@index([locationId])
  @@index([vendorId])
  @@index([qcStatus])
  @@index([expiryDate])
  @@map("inventory_lots")
}

/// The immutable stock ledger. Every receipt, issue, adjustment and transfer
/// is a row here; balances are derived from it. Rows are never updated.
model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  lotId String?
  lot   InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  type StockMovementType

  /// Signed: positive increases stock, negative decreases it. Storing the
  /// sign rather than inferring it from `type` means the ledger sums directly.
  quantity Decimal  @db.Decimal(18, 6)
  unitCost Decimal? @db.Decimal(18, 4)

  /// Running balance immediately after this movement, for audit and for
  /// reconstructing history without replaying the whole ledger.
  balanceAfter Decimal @db.Decimal(18, 6)

  /// What caused the movement, e.g. "GOODS_RECEIPT", "WORK_ORDER".
  referenceType String?
  referenceId   String?

  occurredAt DateTime @default(now())
  notes      String?

  /// Who posted it. Null only for seeded opening balances.
  postedById String?
  postedBy   User?   @relation("StockMovementPostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([materialId, locationId, occurredAt])
  @@index([lotId])
  @@index([referenceType, referenceId])
  @@index([occurredAt])
  @@map("stock_movements")
}

/// A deliberate correction to stock, kept separate from the ledger row it
/// produces so the reason and the approver are recorded.
model InventoryAdjustment {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantityBefore Decimal @db.Decimal(18, 6)
  quantityAfter  Decimal @db.Decimal(18, 6)
  /// Signed delta, stored so the adjustment reads without arithmetic.
  quantityDelta  Decimal @db.Decimal(18, 6)

  reason String
  notes  String?

  createdById String
  createdBy   User   @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialId, locationId])
  @@index([createdById])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

// ===========================================================================
// Demand
// ===========================================================================

model SalesOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "SO-4521".
  orderNumber String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  orderDate    DateTime @db.Date
  /// When the customer needs it. This is the date MRP plans against.
  requiredDate DateTime @db.Date

  status         SalesOrderStatus @default(CONFIRMED)
  deliveryStatus DeliveryStatus   @default(PENDING)

  invoiceNumber String?
  dispatchDate  DateTime? @db.Date

  /// Sum of line totals, maintained by the service layer.
  totalAmount  Decimal @default(0) @db.Decimal(18, 4)
  currencyCode String  @default("INR")

  notes String?

  lines SalesOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([companyId, status])
  @@index([requiredDate])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  lineNumber Int

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity   Decimal @db.Decimal(18, 6)
  /// Already dispatched. Open demand is quantity - shippedQty.
  shippedQty Decimal @default(0) @db.Decimal(18, 6)

  unitPrice Decimal @default(0) @db.Decimal(18, 4)
  lineTotal Decimal @default(0) @db.Decimal(18, 4)

  requiredDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesOrderId, lineNumber])
  @@index([salesOrderId])
  @@index([materialId])
  @@index([locationId])
  @@index([requiredDate])
  @@map("sales_order_lines")
}

/// A forecast for one material at one location. Periods hold the numbers.
model DemandForecast {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Optional: a forecast may be for one customer or for total demand.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  name   String
  method ForecastMethod @default(MANUAL)

  /// Only one active forecast per material/location is consumed by MRP.
  isActive Boolean @default(true)

  periods ForecastPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([materialId, locationId])
  @@index([customerId])
  @@map("demand_forecasts")
}

model ForecastPeriod {
  id         String         @id @default(cuid())
  forecastId String
  forecast   DemandForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  forecastQty Decimal  @db.Decimal(18, 6)
  /// Filled in as the period closes, for the Forecast vs Actuals screen.
  actualQty   Decimal? @db.Decimal(18, 6)

  /// Forecast already met by booked sales orders. MRP counts the larger of
  /// the two rather than both, so confirmed demand does not double-count.
  consumedQty Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([forecastId, periodStart])
  @@index([forecastId])
  @@index([periodStart, periodEnd])
  @@map("forecast_periods")
}

// ===========================================================================
// Procurement
// ===========================================================================

model PurchaseOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "PO-2026-0198".
  orderNumber String

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  /// Where the goods are delivered; also the location MRP counts them at.
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  orderDate            DateTime  @db.Date
  expectedDeliveryDate DateTime  @db.Date
  actualDeliveryDate   DateTime? @db.Date

  status PurchaseOrderStatus @default(DRAFT)

  totalAmount  Decimal @default(0) @db.Decimal(18, 4)
  currencyCode String  @default("INR")

  createdById String
  createdBy   User   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?     @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?

  notes String?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([vendorId])
  @@index([locationId])
  @@index([companyId, status])
  /// MRP scans open POs by expected date; this index is what keeps that fast.
  @@index([expectedDeliveryDate, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  lineNumber Int

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  orderedQty  Decimal @db.Decimal(18, 6)
  /// Incoming supply for MRP is orderedQty - receivedQty.
  receivedQty Decimal @default(0) @db.Decimal(18, 6)

  unitPrice Decimal @default(0) @db.Decimal(18, 4)
  lineTotal Decimal @default(0) @db.Decimal(18, 4)

  expectedDeliveryDate DateTime @db.Date

  grnLines GoodsReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseOrderId, lineNumber])
  @@index([purchaseOrderId])
  @@index([materialId])
  @@index([expectedDeliveryDate])
  @@map("purchase_order_lines")
}

/// Goods Receipt Note. One PO may be received in several GRNs, which is what
/// makes partial receiving work.
model GoodsReceipt {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "GRN-2026-0312".
  grnNumber String

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  receiptDate DateTime @db.Date
  notes       String?

  /// Null only for seeded history.
  receivedById String?
  receivedBy   User?   @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, grnNumber])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  lineNumber Int

  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  /// The lot created by this receipt, when the material is batch tracked.
  lotId String?
  lot   InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  receivedQty Decimal @db.Decimal(18, 6)
  rejectedQty Decimal @default(0) @db.Decimal(18, 6)

  supplierLotNumber String?
  coaReference      String?
  inspectionStatus  QcStatus  @default(PENDING)
  inspectionDate    DateTime? @db.Date
  inspectorName     String?

  storageLocation String?
  bin             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goodsReceiptId, lineNumber])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([materialId])
  @@index([lotId])
  @@map("goods_receipt_lines")
}

// ===========================================================================
// Production
// ===========================================================================

model WorkOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "WO-2026-0042".
  orderNumber String

  /// The material produced.
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  /// The exact version consumed, pinned so history stays explainable when
  /// engineering later revises the BOM.
  bomVersionId String?
  bomVersion   BomVersion? @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  plannedQty  Decimal @db.Decimal(18, 6)
  producedQty Decimal @default(0) @db.Decimal(18, 6)
  scrappedQty Decimal @default(0) @db.Decimal(18, 6)

  plannedStartDate DateTime  @db.Date
  plannedEndDate   DateTime  @db.Date
  actualStartDate  DateTime? @db.Date
  actualEndDate    DateTime? @db.Date

  status   WorkOrderStatus @default(PLANNED)
  priority Int             @default(0)

  notes String?

  operations WorkOrderOperation[]
  components WorkOrderComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([materialId])
  @@index([locationId])
  @@index([companyId, status])
  /// MRP scans open work orders by completion date.
  @@index([plannedEndDate, status])
  @@map("work_orders")
}

model WorkOrderOperation {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  sequence   Int
  name       String
  workCentre String?

  setupMinutes Decimal @default(0) @db.Decimal(12, 2)
  runMinutes   Decimal @default(0) @db.Decimal(12, 2)

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  status OperationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workOrderId, sequence])
  @@index([workOrderId])
  @@map("work_order_operations")
}

/// Materials a work order needs, snapshotted from the BOM when it is created
/// so later BOM edits cannot rewrite what this order was supposed to consume.
model WorkOrderComponent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  requiredQty Decimal @db.Decimal(18, 6)
  issuedQty   Decimal @default(0) @db.Decimal(18, 6)

  /// Set once issued, for backward traceability from finished goods.
  lotId String?
  lot   InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  requiredDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workOrderId, materialId])
  @@index([workOrderId])
  @@index([materialId])
  @@index([lotId])
  @@map("work_order_components")
}

/// A limit that production planning must respect — line capacity, labour,
/// equipment availability or a regulatory cap.
model ProductionConstraint {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  name String
  type ConstraintType

  /// What the constraint is measured in, e.g. "litres/day", "hours/shift".
  unit     String?
  capacity Decimal? @db.Decimal(18, 6)
  /// Currently committed against that capacity.
  utilised Decimal  @default(0) @db.Decimal(18, 6)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([locationId])
  @@index([companyId, isActive])
  @@map("production_constraints")
}

// ===========================================================================
// Planning — MRP
// ===========================================================================

/// One execution of the MRP engine. Append-only: a run never overwrites an
/// earlier one, so historical runs stay comparable.
model MrpRun {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Business key: "MRP-2026-0007".
  runNumber String

  status MrpRunStatus @default(DRAFT)

  /// The planning "today". Every bucket and lead-time offset is computed from
  /// this, never from the wall clock, so a run is reproducible.
  asOfDate       DateTime @db.Date
  /// How far ahead the run plans.
  horizonDays    Int
  /// Bucket width in days; 1 is daily.
  bucketSizeDays Int      @default(1)

  /// A what-if planned from a date other than today. Kept for comparison,
  /// but never the latest plan and never converted into orders.
  isSimulation Boolean @default(false)

  /// Hash of the input snapshot. Two runs with the same hash saw the same
  /// data, which is what lets the UI say whether a difference is real.
  inputHash String?

  triggeredById String
  triggeredBy   User   @relation("MrpRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  /// Populated when status is FAILED.
  errorMessage String?

  /// Headline counts, denormalised so list screens need no aggregation.
  materialsPlanned  Int @default(0)
  plannedOrderCount Int @default(0)
  exceptionCount    Int @default(0)

  parameters    MrpRunParameter[]
  requirements  MrpRequirement[]
  plannedOrders PlannedOrder[]
  exceptions    MrpException[]
  peggings      MrpPegging[]
  explanations  MrpExplanation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, runNumber])
  @@index([companyId])
  @@index([companyId, status])
  /// "Latest plan" is the newest completed non-simulation run.
  @@index([companyId, isSimulation, status, completedAt])
  @@index([asOfDate])
  @@map("mrp_runs")
}

/// The settings a run used, captured so the result can be explained and
/// reproduced even after the defaults change.
model MrpRunParameter {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  key   String
  value Json

  createdAt DateTime @default(now())

  @@unique([mrpRunId, key])
  @@index([mrpRunId])
  @@map("mrp_run_parameters")
}

/// One time bucket for one material at one location: the full gross-to-net
/// calculation, stored so the UI can show the workings rather than a number.
model MrpRequirement {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// BOM depth. Level 0 is planned first; a component is never planned before
  /// every parent that consumes it.
  lowLevelCode Int

  bucketStart DateTime @db.Date
  bucketEnd   DateTime @db.Date

  grossRequirement  Decimal @default(0) @db.Decimal(18, 6)
  scheduledReceipts Decimal @default(0) @db.Decimal(18, 6)
  projectedOnHand   Decimal @default(0) @db.Decimal(18, 6)
  safetyStock       Decimal @default(0) @db.Decimal(18, 6)
  netRequirement    Decimal @default(0) @db.Decimal(18, 6)
  plannedReceipt    Decimal @default(0) @db.Decimal(18, 6)
  plannedRelease    Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@unique([mrpRunId, materialId, locationId, bucketStart])
  @@index([mrpRunId])
  @@index([mrpRunId, materialId])
  @@index([materialId, locationId])
  @@map("mrp_requirements")
}

/// A recommended purchase or production order.
model PlannedOrder {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  type   PlannedOrderType
  status PlannedOrderStatus @default(PLANNED)

  quantity Decimal @db.Decimal(18, 6)

  /// When the order must be placed or production started.
  releaseDate  DateTime @db.Date
  /// When the quantity is needed.
  requiredDate DateTime @db.Date

  leadTimeDays   Int
  /// "VENDOR:SUP-001" or "PRODUCTION" — names where the lead time came from.
  leadTimeSource String?

  /// Suggested vendor for a purchase recommendation.
  suggestedVendorId String?

  lowLevelCode Int @default(0)

  /// Set when the recommendation has been turned into a real order.
  convertedToPurchaseOrderId String?
  convertedToWorkOrderId     String?
  convertedAt                DateTime?

  peggings    MrpPegging[]
  explanation MrpExplanation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mrpRunId])
  @@index([mrpRunId, type])
  @@index([materialId, locationId])
  @@index([releaseDate])
  @@index([mrpRunId, status])
  @@map("planned_orders")
}

/// Links a planned order to the demand that caused it.
///
/// This is what makes the plan answerable: for any recommendation you can
/// list the sales orders and forecast periods it exists to satisfy, and how
/// much of it each one accounts for.
model MrpPegging {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  plannedOrderId String
  plannedOrder   PlannedOrder @relation(fields: [plannedOrderId], references: [id], onDelete: Cascade)

  demandSourceType DemandSourceType
  /// Id of the sales order line, forecast period, or parent planned order.
  demandSourceId   String?
  /// Human-readable reference shown in the UI, e.g. "SO-4521".
  demandReference  String?

  /// How much of the planned order this demand accounts for.
  quantity     Decimal  @db.Decimal(18, 6)
  requiredDate DateTime @db.Date

  /// For DEPENDENT demand, the parent planned order that exploded into this.
  parentPlannedOrderId String?

  createdAt DateTime @default(now())

  @@index([mrpRunId])
  @@index([plannedOrderId])
  @@index([demandSourceType, demandSourceId])
  @@index([parentPlannedOrderId])
  @@map("mrp_peggings")
}

/// The arithmetic behind one planned order, stored as structured JSON so the
/// UI can render "why" without recomputing anything.
model MrpExplanation {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  plannedOrderId String       @unique
  plannedOrder   PlannedOrder @relation(fields: [plannedOrderId], references: [id], onDelete: Cascade)

  /// Ordered calculation steps: gross requirement, on hand, scheduled
  /// receipts, safety stock, net requirement, lot sizing, lead-time offset.
  steps Json

  /// One-line plain-English summary, precomputed for list views.
  summary String?

  createdAt DateTime @default(now())

  @@index([mrpRunId])
  @@map("mrp_explanations")
}

/// Something the planner needs to look at: a shortage, a late supply, a
/// release date already in the past, or missing master data.
model MrpException {
  id       String @id @default(cuid())
  mrpRunId String
  mrpRun   MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  type     MrpExceptionType
  severity ExceptionSeverity @default(MEDIUM)

  message         String
  /// Suggested resolution, e.g. "Place emergency PO".
  suggestedAction String?

  /// Shortfall or lateness, depending on the exception type.
  quantity Decimal?  @db.Decimal(18, 6)
  dueDate  DateTime? @db.Date
  /// Days late, for LATE_SUPPLY and PAST_DUE_RELEASE.
  daysLate Int?

  /// The planned order or scheduled receipt this exception concerns.
  referenceType String?
  referenceId   String?

  isResolved Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mrpRunId])
  @@index([mrpRunId, type])
  @@index([mrpRunId, severity])
  @@index([materialId, locationId])
  @@map("mrp_exceptions")
}

// ===========================================================================
// Cross-cutting
// ===========================================================================

/// Immutable record of who changed what. Written by the service layer for
/// every mutation that matters: MRP runs, inventory adjustments, purchase and
/// work orders, and user or role changes.
model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Null for actions with no authenticated actor, e.g. a failed login.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  /// Table the change concerns, e.g. "purchase_orders".
  entityType  String
  entityId    String
  /// Business key, kept so the log stays readable after the row is deleted.
  entityLabel String?

  /// Field-level before and after. Null on create and delete respectively.
  previousValues Json?
  newValues      Json?

  /// Correlates an entry with the API request or MRP run that produced it.
  requestId String?
  mrpRunId  String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([mrpRunId])
  @@index([action])
  @@map("audit_logs")
}

/// An external system connection shown on the Integrations screen.
model Integration {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code     String
  name     String
  /// ERP, WMS, ACCOUNTING, ECOMMERCE, ...
  category String

  status IntegrationStatus @default(DISCONNECTED)

  /// Non-secret configuration only. Credentials belong in a secret store,
  /// never in this table.
  config Json?

  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastErrorText  String?

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("integrations")
}

/// Next number for a business document series, per company: "PO-2026",
/// "GRN-2026", "RMB-2026". Incremented with a single UPDATE ... RETURNING, so
/// two concurrent requests can never be handed the same number, and a rolled
/// back transaction gives its number back.
model DocumentSequence {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Series prefix including the year, e.g. "PO-2026".
  series    String
  /// The last number issued in the series.
  lastValue Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, series])
  @@map("document_sequences")
}

/// A client-supplied Idempotency-Key and the response it produced, so a
/// retried or double-submitted POST (a goods receipt, a dispatch) is applied
/// once and answered the same way every time.
model IdempotencyKey {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key    String
  /// The operation the key was used for, e.g. "goods-receipt:create". The
  /// same key sent to a different operation is rejected, not replayed.
  scope  String
  userId String

  /// SHA-256 of the request body, so a reused key with a different payload
  /// is refused instead of silently returning the first result.
  requestHash    String
  responseStatus Int
  responseBody   Json

  createdAt DateTime @default(now())

  @@unique([companyId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Fixed-window request counters for rate limiting, keyed by what is being
/// limited ("login:ip:203.0.113.9"). Kept in Postgres rather than process
/// memory so every server instance shares the same count.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
